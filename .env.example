# 복사해서 .env 로 저장한 뒤 값을 채운다. .env 는 git에 올리지 않는다.
# 설명은 README의 "설정" 절과 docs/OVERVIEW.md 6절에 있다.

# ── 대화 모델 (답변 문장을 쓰는 Claude) ─────────────────────────────
# 키가 없으면 처음 화면의 추천 질문만 저장된 답변으로 나온다.
ANTHROPIC_API_KEY=
# 기본값은 요금이 가장 낮은 모델이다. 값만 바꾸면 상위 모델로 돈다.
CHAT_MODEL=claude-haiku-5-5
# 사고 깊이: low | medium | high
CHAT_EFFORT=low

# ── 예측을 가져오는 방식 ────────────────────────────────────────────
#   lookup: 미리 계산해 둔 예측을 꺼낸다 (기본. GPU 필요 없음. 시연과 발표에는 이것을 쓴다)
#   live:   GPU에서 Bllossom 8B를 원래 정밀도로 올려 즉석 계산한다 (GPU 메모리 16GB 이상)
#   gguf:   GPU 없이 4비트로 줄인 Bllossom 8B를 CPU에서 즉석 계산한다 (RAM 8GB 이상.
#           값이 저장된 예측과 꽤 다르다. 흐름을 돌려 보는 용도)
PREDICT_BACKEND=lookup

# ── live 설정 (비워 두면 알아서 고른다) ─────────────────────────────
# LIVE_DEVICE=cuda        # cuda | mps | xpu | cpu
# LIVE_4BIT=1             # GPU 메모리가 16GB보다 작을 때 (bitsandbytes 필요, 값이 조금 달라진다)
# LIVE_BASE_MODEL=MLP-KTLim/llama-3-Korean-Bllossom-8B     # 미리 받아 둔 폴더 경로도 된다

# ── gguf 설정 (비워 두면 models/ 의 4비트 파일을 쓴다) ───────────────
# 먼저 받는다:  cd backend && python -m suwon_chat.quantized --download
# GGUF_MODEL=/받아/둔/파일.gguf   # 다른 곳에 받아 둔 모델 파일을 쓸 때 (절대 경로)
# GGUF_THREADS=8                 # CPU 스레드 수 (비워 두면 코어의 절반)
