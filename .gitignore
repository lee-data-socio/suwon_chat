/models/

# 만들어지는 파일
/data/
__pycache__/
*.pyc
.pytest_cache/
node_modules/
/frontend/dist/

# 비밀 값과 도구 상태
.env
.omc/
.vscode/

# 내부용 기획 문서 (공개하지 않는다)
