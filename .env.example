# 복사해서 .env 로 저장한 뒤 값을 채운다. .env 는 git에 올리지 않는다.
ANTHROPIC_API_KEY=
# 대화 모델. 기본값은 요금이 가장 낮은 모델이다. 값만 바꾸면 상위 모델로 돈다.
CHAT_MODEL=claude-haiku-5-5
# 사고 깊이: low | medium | high
CHAT_EFFORT=low

# 예측 방식. lookup: 저장된 예측을 조회한다(기본, GPU 필요 없음). live: Bllossom 8B를 직접 돌린다
PREDICT_BACKEND=lookup
# 실시간 예측 설정 (비워 두면 알아서 고른다)
# LIVE_DEVICE=cuda        # cuda | mps | cpu
# LIVE_4BIT=1             # GPU 메모리가 16GB보다 작을 때 (bitsandbytes 필요, 값이 조금 달라진다)
# LIVE_BASE_MODEL=MLP-KTLim/llama-3-Korean-Bllossom-8B     # 미리 받아 둔 폴더 경로도 된다
